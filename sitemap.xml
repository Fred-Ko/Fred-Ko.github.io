---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for collection in site.collections %}{% if collection.output == false %}{% continue %}{% endif %}
{%- assign docs = collection.docs | where_exp: 'doc', 'doc.sitemap != false' %}
{%- for doc in docs %}
<url>
<loc>{{ doc.url | replace: '/index.html', '/' | absolute_url | xml_escape }}</loc>
{%- if doc.last_modified_at or doc.date %}
<lastmod>{{ doc.last_modified_at | default: doc.date | date_to_xmlschema }}</lastmod>
{%- endif %}
</url>
{%- endfor %}{% endfor %}
{%- assign pages = site.pages | where_exp: 'p', 'p.sitemap != false' | where_exp: 'p', 'p.url != "/404.html"' | where_exp: 'p', 'p.name != "sitemap.xml"' %}
{%- for p in pages %}
{%- assign ext = p.name | split: '.' | last %}
{%- if ext != 'html' and ext != 'md' and p.url != '/' and p.type == nil %}{% continue %}{% endif %}
{%- if p.type == 'tag' and p.posts.size < 2 %}{% continue %}{% endif %}
<url>
<loc>{{ p.url | replace: '/index.html', '/' | absolute_url | xml_escape }}</loc>
{%- if p.last_modified_at %}
<lastmod>{{ p.last_modified_at | date_to_xmlschema }}</lastmod>
{%- endif %}
</url>
{%- endfor %}
</urlset>
