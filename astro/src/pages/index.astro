---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import Kicker from '../components/ui/Kicker.astro';
---

<BaseLayout title="Fredko Dev Log">
  <section class="container placeholder">
    <Kicker items={['Astro migration', 'WIP']} />
    <h1>Fredko<b>.</b></h1>
    <p>Astro 이전 작업 중입니다. 현재는 디자인 시스템만 준비되어 있습니다.</p>
    <Button variant="solid" href="/design-system/" arrow="→">Design system</Button>
  </section>
</BaseLayout>

<style>
  .placeholder {
    display: grid;
    gap: var(--space-8);
    justify-items: start;
    padding-block: var(--space-24);
  }

  h1 {
    font-size: var(--text-hero);
    letter-spacing: var(--tracking-hero);
    line-height: var(--leading-hero);
  }

  b {
    color: var(--accent);
    font-weight: inherit;
  }

  p {
    color: var(--fg-muted);
  }
</style>
