---
/** Badge — 인라인 상태 표시. */
interface Props {
  tone?: 'neutral' | 'accent' | 'warning' | 'danger';
}
const { tone = 'neutral' } = Astro.props;
---

<span class="badge" data-tone={tone}><slot /></span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    padding: 0.1em 0.5em;
    border: var(--border-thin) solid var(--badge-line, var(--line-strong));
    background: var(--badge-bg, transparent);
    color: var(--badge-fg, var(--fg-muted));
    font-family: var(--font-display);
    font-size: 0.75em;
    font-weight: var(--weight-semibold);
    letter-spacing: 0.04em;
    line-height: 1.5;
    vertical-align: 0.12em;
    white-space: nowrap;
  }

  [data-tone='accent'] {
    --badge-line: var(--accent);
    --badge-bg: var(--accent);
    --badge-fg: var(--accent-fg);
  }

  [data-tone='warning'] {
    --badge-line: var(--warning-line);
    --badge-fg: var(--warning-line);
  }

  [data-tone='danger'] {
    --badge-line: var(--danger-line);
    --badge-fg: var(--danger-line);
  }
</style>
