---
/**
 * Tabs — 자식 <Tab>들로 탭 목록을 만든다(점진적 향상).
 *  - JS 없음: 각 패널이 라벨과 함께 세로로 나열
 *  - JS 있음: WAI-ARIA tabs 패턴(←/→/Home/End 키), syncKey가 같은 그룹끼리 선택 공유·저장
 */
interface Props {
  syncKey?: string;
}
const { syncKey } = Astro.props;
---

<div class="tabs" data-tabs data-sync-key={syncKey}>
  <slot />
</div>

<script>
  const STORAGE_PREFIX = 'tabs:';

  function select(root: HTMLElement, index: number, focus = false) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>(':scope > [role="tablist"] > [role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>(':scope > .tab-panel')];
    tabs.forEach((tab, i) => {
      const on = i === index;
      tab.setAttribute('aria-selected', String(on));
      tab.tabIndex = on ? 0 : -1;
      panels[i].hidden = !on;
      if (on && focus) tab.focus();
    });
  }

  function syncGroup(key: string, label: string) {
    document.querySelectorAll<HTMLElement>(`[data-tabs][data-sync-key="${CSS.escape(key)}"]`).forEach((root) => {
      const labels = [...root.querySelectorAll<HTMLElement>(':scope > .tab-panel')].map((p) => p.dataset.tabLabel);
      const i = labels.indexOf(label);
      if (i >= 0) select(root, i);
    });
  }

  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root, n) => {
    const panels = [...root.querySelectorAll<HTMLElement>(':scope > .tab-panel')];
    if (panels.length === 0) return;
    const list = document.createElement('div');
    list.setAttribute('role', 'tablist');
    panels.forEach((panel, i) => {
      const id = `tabs-${n}-${i}`;
      panel.id = `${id}-panel`;
      panel.setAttribute('aria-labelledby', `${id}-tab`);
      const tab = document.createElement('button');
      tab.type = 'button';
      tab.id = `${id}-tab`;
      tab.setAttribute('role', 'tab');
      tab.setAttribute('aria-controls', panel.id);
      tab.textContent = panel.dataset.tabLabel ?? `Tab ${i + 1}`;
      tab.addEventListener('click', () => {
        select(root, i);
        const key = root.dataset.syncKey;
        if (key) {
          syncGroup(key, tab.textContent ?? '');
          try {
            localStorage.setItem(STORAGE_PREFIX + key, tab.textContent ?? '');
          } catch {}
        }
      });
      list.append(tab);
    });
    list.addEventListener('keydown', (e) => {
      const tabs = [...list.children] as HTMLButtonElement[];
      const current = tabs.indexOf(document.activeElement as HTMLButtonElement);
      const next = { ArrowRight: current + 1, ArrowLeft: current - 1, Home: 0, End: tabs.length - 1 }[e.key];
      if (next === undefined) return;
      e.preventDefault();
      select(root, (next + tabs.length) % tabs.length, true);
    });
    root.prepend(list);
    root.dataset.enhanced = '';

    let initial = 0;
    const key = root.dataset.syncKey;
    if (key) {
      try {
        const saved = localStorage.getItem(STORAGE_PREFIX + key);
        const i = panels.findIndex((p) => p.dataset.tabLabel === saved);
        if (i >= 0) initial = i;
      } catch {}
    }
    select(root, initial);
  });
</script>

<style>
  .tabs {
    margin: var(--space-8) 0;
  }

  .tabs :global([role='tablist']) {
    display: flex;
    overflow-x: auto;
    border-bottom: var(--border-thin) solid var(--line);
    scrollbar-width: none;
  }

  .tabs :global([role='tab']) {
    min-height: var(--tap-target);
    padding: 0 var(--space-4);
    border-bottom: var(--border-thick) solid transparent;
    margin-bottom: -1px;
    color: var(--fg-subtle);
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    white-space: nowrap;
  }

  .tabs :global([role='tab']:hover) {
    color: var(--fg-strong);
  }

  .tabs :global([role='tab'][aria-selected='true']) {
    border-bottom-color: var(--accent);
    color: var(--fg-strong);
  }

  /* 패널 안의 첫 코드 블록은 탭 바로 아래 붙인다 */
  .tabs[data-enhanced] :global(.tab-panel > .code-block:first-of-type) {
    margin-top: 0;
    border-top: 0;
  }

  .tabs[data-enhanced] :global(.tab-panel) {
    padding-top: var(--space-4);
  }

  .tabs[data-enhanced] :global(.tab-panel:has(> .code-block:first-of-type)) {
    padding-top: 0;
  }

  .tabs[data-enhanced] :global(.tab-fallback-label) {
    display: none;
  }

  .tabs :global(.tab-fallback-label) {
    margin-bottom: var(--space-2);
    color: var(--fg-subtle);
  }
</style>
