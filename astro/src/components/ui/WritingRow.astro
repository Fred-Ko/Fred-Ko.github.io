---
/**
 * WritingRow — 글 목록 한 줄. <WritingList> 안에서만 쓴다.
 * - 호버 시 행 전체가 포인트 컬러로 반전(시그니처 인터랙션)
 * - 레이아웃은 뷰포트가 아니라 WritingList 컨테이너 폭에 반응(container query)
 * - transitionName을 주면 포스트 제목과 View Transition으로 이어진다(PostHero에도 같은 값)
 */
interface Props {
  href: string;
  index: number;
  title: string;
  date: Date;
  category?: string;
  readingMinutes?: number;
  transitionName?: string;
}
const { href, index, title, date, category, readingMinutes, transitionName } = Astro.props;
const dateLabel = date.toLocaleDateString('ko-KR', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
  timeZone: 'Asia/Seoul',
});
---

<li class="row">
  <a href={href}>
    <span class="index">{String(index).padStart(2, '0')}</span>
    <span class="info">
      <h3 style={transitionName ? `view-transition-name: ${transitionName}` : undefined}>{title}</h3>
      <span class="meta">
        <time datetime={date.toISOString()}>{dateLabel}</time>
        {category && <span>{category}</span>}
        {readingMinutes && <span>{readingMinutes}분</span>}
      </span>
    </span>
    <span class="arrow" aria-hidden="true">→</span>
  </a>
</li>

<style>
  .row {
    border-bottom: var(--border-thin) solid var(--line);
    list-style: none;
  }

  a {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr) 4rem;
    align-items: center;
    min-height: 7.25rem;
    padding: var(--space-6) var(--space-4);
    color: inherit;
    text-decoration: none;
    transition:
      padding var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-standard),
      color var(--duration-fast) var(--ease-standard);
  }

  a:hover,
  a:focus-visible {
    padding-inline: var(--space-6);
    background: var(--accent);
    color: var(--accent-fg);
    outline-offset: -2px;
  }

  .index,
  .meta,
  .arrow {
    font-family: var(--font-display);
  }

  .index {
    align-self: start;
    padding-top: 0.35rem;
    color: var(--fg-subtle);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-label);
  }

  h3 {
    color: inherit;
    font-size: var(--text-3xl);
    line-height: 1.25;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-3);
    color: var(--fg-subtle);
    font-size: var(--text-2xs);
    letter-spacing: 0.04em;
  }

  a:hover :is(.index, .meta),
  a:focus-visible :is(.index, .meta) {
    color: var(--accent-fg-muted);
  }

  .arrow {
    justify-self: end;
    font-size: 1.5rem;
    transition: transform var(--duration-fast) var(--ease-standard);
  }

  a:hover .arrow {
    transform: translateX(0.4rem);
  }

  @container writing (width < 40rem) {
    a {
      grid-template-columns: 2.5rem minmax(0, 1fr);
      min-height: auto;
      padding: var(--space-5) 0;
    }

    a:hover,
    a:focus-visible {
      padding-inline: var(--space-3);
    }

    .arrow {
      display: none;
    }
  }
</style>
