---
/**
 * SeriesNav — 연재 글 목차. 현재 글은 aria-current로 표시하고 이전/다음 편 링크를 준다.
 */
interface Part {
  title: string;
  href: string;
}
interface Props {
  name: string;
  parts: Part[];
  current: number; // 0부터
}
const { name, parts, current } = Astro.props;
const prev = parts[current - 1];
const next = parts[current + 1];
---

<nav class="series" aria-label={`연재: ${name}`}>
  <header>
    <span class="label">Series · {current + 1} / {parts.length}</span>
    <p class="name">{name}</p>
  </header>
  <ol>
    {
      parts.map((part, i) => (
        <li>
          {i === current ? (
            <span aria-current="page">{part.title}</span>
          ) : (
            <a href={part.href}>{part.title}</a>
          )}
        </li>
      ))
    }
  </ol>
  {
    (prev || next) && (
      <footer>
        {prev ? <a href={prev.href} rel="prev">← 이전 편</a> : <span />}
        {next && <a href={next.href} rel="next">다음 편 →</a>}
      </footer>
    )
  }
</nav>

<style>
  .series {
    margin: var(--space-8) 0;
    border: var(--border-thin) solid var(--line);
    background: var(--bg-raised);
  }

  header {
    padding: var(--space-4) var(--space-5) var(--space-3);
    border-bottom: var(--border-thin) solid var(--line-soft);
  }

  header .label {
    color: var(--accent);
  }

  .name {
    margin: var(--space-1) 0 0;
    color: var(--fg-strong);
    font-family: var(--font-display);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-heading);
  }

  ol {
    margin: 0;
    padding: var(--space-3) var(--space-5) var(--space-3) calc(var(--space-5) + 1.5rem);
    font-size: var(--text-sm);
  }

  li + li {
    margin-top: var(--space-1);
  }

  ol a {
    color: var(--fg-muted);
    text-decoration: none;
  }

  ol a:hover {
    color: var(--fg-strong);
  }

  [aria-current] {
    color: var(--fg-strong);
    font-weight: var(--weight-semibold);
  }

  footer {
    display: flex;
    justify-content: space-between;
    padding: var(--space-3) var(--space-5);
    border-top: var(--border-thin) solid var(--line-soft);
    font-family: var(--font-display);
    font-size: var(--text-xs);
  }

  footer a {
    color: var(--fg-strong);
    text-decoration: none;
  }

  footer a:hover {
    color: var(--accent);
  }
</style>
