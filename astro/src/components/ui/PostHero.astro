---
/**
 * PostHero — 포스트 상단. Kicker → 제목 → 설명 → 메타 → 태그 순서의 중앙 정렬 블록.
 */
import Kicker from './Kicker.astro';
import Tag from './Tag.astro';

interface Props {
  title: string;
  description?: string;
  category?: string;
  date: Date;
  updated?: Date;
  readingMinutes?: number;
  tags?: string[];
}
const { title, description, category, date, updated, readingMinutes, tags = [] } = Astro.props;
const fmt = (d: Date) =>
  d.toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'Asia/Seoul' });
---

<header class="post-hero">
  <Kicker align="center" items={[category ?? 'Post', String(date.getFullYear())]} />
  <h1>{title}</h1>
  {description && <p class="desc">{description}</p>}
  <p class="meta">
    <span><time datetime={date.toISOString()}>{fmt(date)}</time></span>
    {updated && <span>수정 <time datetime={updated.toISOString()}>{fmt(updated)}</time></span>}
    {readingMinutes && <span>{readingMinutes}분 분량</span>}
  </p>
  {
    tags.length > 0 && (
      <ul class="tags" role="list">
        {tags.map((tag) => (
          <li>
            <Tag href={`/tags/${tag}/`}>{tag}</Tag>
          </li>
        ))}
      </ul>
    )
  }
</header>

<style>
  .post-hero {
    padding: 6.5rem 0 4.5rem;
    text-align: center;
  }

  h1 {
    margin: 1.7rem auto 0;
    font-size: var(--text-4xl);
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-heading);
  }

  .desc {
    max-width: 42rem;
    margin: var(--space-8) auto 0;
    color: var(--fg-muted);
    font-size: var(--text-lg);
    line-height: 1.75;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.2rem;
    margin-top: var(--space-8);
    color: var(--fg-subtle);
    font-family: var(--font-display);
    font-size: var(--text-2xs);
  }

  .meta > span + span::before {
    margin-right: 1.2rem;
    color: var(--line);
    content: '•';
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.65rem 0.45rem;
    margin-top: var(--space-8);
    padding: 0;
    list-style: none;
  }
</style>
