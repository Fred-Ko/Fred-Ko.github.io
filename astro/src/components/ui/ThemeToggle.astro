---
/**
 * ThemeToggle — 시스템 / 라이트 / 다크 3단 선택.
 *  - 시스템: html[data-theme] 제거 → color-scheme: light dark가 OS 설정을 따름
 *  - 라이트/다크: html[data-theme] 고정 + localStorage('theme') 저장
 * 첫 페인트 전 적용은 BaseLayout의 인라인 스크립트가 담당한다.
 */
const options = [
  { value: 'system', label: '시스템 설정', icon: 'M4 5h16v11H4zM8 20h8M12 16v4' },
  {
    value: 'light',
    label: '라이트',
    icon: 'M12 8a4 4 0 1 0 0 8a4 4 0 1 0 0-8M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4',
  },
  { value: 'dark', label: '다크', icon: 'M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z' },
] as const;
---

<div class="theme-toggle" role="radiogroup" aria-label="테마" data-theme-toggle>
  {
    options.map((o) => (
      <button type="button" role="radio" aria-checked="false" data-value={o.value} title={o.label}>
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d={o.icon} />
        </svg>
        <span class="sr-only">{o.label}</span>
      </button>
    ))
  }
</div>

<script>
  type Mode = 'system' | 'light' | 'dark';

  const current = (): Mode => {
    const t = document.documentElement.dataset.theme;
    return t === 'light' || t === 'dark' ? t : 'system';
  };

  function apply(mode: Mode) {
    const root = document.documentElement;
    const update = () => {
      if (mode === 'system') delete root.dataset.theme;
      else root.dataset.theme = mode;
      sync();
    };
    // 지원 브라우저에서는 테마 전환도 부드럽게 (같은 문서 View Transition)
    if (document.startViewTransition && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.startViewTransition(update);
    } else update();
    try {
      if (mode === 'system') localStorage.removeItem('theme');
      else localStorage.setItem('theme', mode);
    } catch {}
  }

  function sync() {
    const mode = current();
    document.querySelectorAll<HTMLElement>('[data-theme-toggle] [role="radio"]').forEach((btn) => {
      const on = btn.dataset.value === mode;
      btn.setAttribute('aria-checked', String(on));
      btn.tabIndex = on ? 0 : -1;
    });
  }

  document.querySelectorAll<HTMLElement>('[data-theme-toggle]').forEach((group) => {
    const radios = [...group.querySelectorAll<HTMLButtonElement>('[role="radio"]')];
    radios.forEach((btn) => btn.addEventListener('click', () => apply(btn.dataset.value as Mode)));
    group.addEventListener('keydown', (e) => {
      const i = radios.indexOf(document.activeElement as HTMLButtonElement);
      const delta = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 }[e.key];
      if (i < 0 || !delta) return;
      e.preventDefault();
      const next = radios[(i + delta + radios.length) % radios.length];
      next.focus();
      apply(next.dataset.value as Mode);
    });
  });
  sync();
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    padding: 2px;
    border: var(--border-thin) solid var(--toggle-border);
    border-radius: var(--radius-pill);
    background: var(--toggle-bg);
  }

  button {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: var(--radius-pill);
    color: var(--fg-subtle);
    transition:
      background-color var(--duration-fast) var(--ease-standard),
      color var(--duration-fast) var(--ease-standard);
  }

  button:hover {
    color: var(--fg-strong);
  }

  button[aria-checked='true'] {
    background: var(--toggle-active-bg);
    color: var(--toggle-icon);
    box-shadow: 0 0 0 1px var(--toggle-border);
  }
</style>
