---
/**
 * ThemeToggle — 다크/라이트 스위치. 선택은 localStorage('theme')에 저장된다.
 * 초기 테마 적용(깜빡임 방지)은 BaseLayout의 인라인 스크립트가 담당한다.
 */
---

<button type="button" class="theme-toggle" data-theme-toggle aria-label="라이트/다크 모드 전환">
  <span class="thumb" aria-hidden="true">
    <svg class="sun" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
    </svg>
    <svg class="moon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
    </svg>
  </span>
</button>

<script>
  function syncPressed() {
    const isDark = document.documentElement.dataset.theme !== 'light';
    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) => {
      btn.setAttribute('aria-pressed', String(isDark));
    });
  }

  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
      document.documentElement.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {
        /* 저장 불가 환경(시크릿 모드 등)에서는 세션 동안만 유지 */
      }
      syncPressed();
    });
  });
  syncPressed();
</script>

<style>
  .theme-toggle {
    position: relative;
    width: 2.75rem;
    height: 1.5rem;
    border: var(--border-thin) solid var(--toggle-border);
    border-radius: var(--radius-pill);
    background: var(--toggle-bg);
    --toggle-border: #3c3f44;
    --toggle-bg: rgb(101 117 133 / 16%);
    --toggle-thumb: #000000;
    --toggle-icon: rgb(255 255 245 / 86%);
  }

  :global(:root[data-theme='light']) .theme-toggle {
    --toggle-border: #c2c2c4;
    --toggle-bg: rgb(142 150 170 / 14%);
    --toggle-thumb: #ffffff;
    --toggle-icon: #67676c;
  }

  .thumb {
    position: absolute;
    top: 1px;
    left: 1px;
    display: grid;
    place-items: center;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: var(--radius-pill);
    background: var(--toggle-thumb);
    color: var(--toggle-icon);
    transform: translateX(1.25rem);
    transition: transform var(--duration-base) var(--ease-out);
  }

  :global(:root[data-theme='light']) .thumb {
    transform: translateX(0);
  }

  .thumb svg {
    grid-area: 1 / 1;
    transition: opacity var(--duration-fast) var(--ease-standard);
  }

  .sun {
    opacity: 0;
  }

  :global(:root[data-theme='light']) .sun {
    opacity: 1;
  }

  :global(:root[data-theme='light']) .moon {
    opacity: 0;
  }
</style>
