---
/** SiteHeader — 상단 고정 바. 브랜드, 주요 탭, 검색(⌘K), 테마 선택. */
import ThemeToggle from './ThemeToggle.astro';

const nav = [
  { href: '/', label: 'Writing' },
  { href: '/categories/', label: 'Categories' },
  { href: '/tags/', label: 'Tags' },
  { href: '/about/', label: 'About' },
];
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header">
  <div class="container inner">
    <a class="brand" href="/">Fredko<span>.</span></a>
    <nav aria-label="주 메뉴">
      <ul role="list">
        {
          nav.map((item) => (
            <li>
              <a class="label" href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <button type="button" class="search-trigger" data-search-open aria-label="검색 (⌘K)">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path>
      </svg>
      <kbd class="label">⌘K</kbd>
    </button>
    <ThemeToggle />
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-topbar);
    border-bottom: var(--border-thin) solid var(--line);
    background: var(--bg-overlay);
    backdrop-filter: blur(12px);
    view-transition-name: site-header; /* 페이지 이동 중 헤더 고정 */
  }

  .inner {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    height: var(--topbar-height);
  }

  .brand {
    color: var(--fg-strong);
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: var(--weight-bold);
    letter-spacing: -0.05em;
    text-decoration: none;
  }

  .brand span {
    color: var(--accent);
  }

  nav {
    margin-left: auto;
    overflow-x: auto;
    scrollbar-width: none;
  }

  ul {
    display: flex;
    gap: var(--space-6);
    padding: 0;
    list-style: none;
  }

  nav a {
    display: inline-block;
    padding-block: var(--space-2);
    color: var(--fg-subtle);
    text-decoration: none;
    white-space: nowrap;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--fg-strong);
  }

  nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.5em;
  }

  .search-trigger {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    height: 2rem;
    padding: 0 var(--space-2);
    border: var(--border-thin) solid var(--line-control);
    color: var(--fg-subtle);
  }

  .search-trigger:hover {
    border-color: var(--hover-border);
    color: var(--fg-strong);
  }

  kbd {
    font-family: var(--font-display);
  }

  @media (width < 720px) {
    .inner {
      gap: var(--space-3);
    }

    ul {
      gap: var(--space-4);
    }

    kbd {
      display: none;
    }
  }

  @media (width < 480px) {
    nav {
      display: none; /* 모바일: 탭은 페이지 하단/홈에서 제공 */
    }

    .search-trigger {
      margin-left: auto;
    }
  }
</style>
