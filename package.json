{
  "name": "fredko-blog-astro",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build && pagefind --site dist && node scripts/build-ready.ts",
    "preview": "node scripts/preview.ts",
    "check:catalog": "node scripts/check-catalog.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "test": "npm run check:catalog && npm run check:contrast && npm run test:posts && npm run test:publishing && npm run test:preview && npm run test:exports",
    "test:posts": "node --test tests/posts.test.ts",
    "migrate:posts": "node scripts/migration/migrate-posts.ts",
    "check:migration": "node scripts/migration/migrate-posts.ts --check",
    "test:migration": "node --test tests/migration/migration.test.ts",
    "check:site": "node scripts/check-site.ts",
    "test:browser": "playwright test",
    "check:types": "astro check",
    "check:baseline": "node scripts/migration/check-baseline.ts",
    "test:publishing": "node --test tests/publishing.test.ts",
    "test:preview": "node --test tests/preview.test.ts",
    "prepare:content": "node scripts/prepare-content.ts",
    "prebuild": "npm run prepare:content",
    "predev": "npm run prepare:content",
    "precheck:types": "npm run prepare:content",
    "test:exports": "node --test tests/exports.test.ts"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.9",
    "@astrojs/mdx": "8.1.5",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@resvg/resvg-js": "2.6.2",
    "@shikijs/transformers": "4.6.0",
    "astro": "7.4.11",
    "pretendard": "1.3.9",
    "satori": "0.63.2",
    "satteri": "0.11.7",
    "tinyglobby": "0.2.17",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "pagefind": "1.6.0",
    "typescript": "6.0.3"
  }
}
