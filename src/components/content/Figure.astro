---
/**
 * Figure — 캡션 있는 이미지. 클릭하면 Popover API로 확대(JS 없음).
 * Popover 미지원 브라우저에서는 버튼이 아무 동작도 하지 않을 뿐 이미지는 그대로 보인다.
 */
interface Props {
  src: string;
  alt: string;
  caption?: string;
  width?: number;
  height?: number;
}
const { src, alt, caption, width, height } = Astro.props;
const id = `zoom-${Math.random().toString(36).slice(2, 9)}`;
---

<figure class="figure">
  <button type="button" class="zoom-trigger" popovertarget={id} aria-label={`${alt} — 크게 보기`}>
    <img src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
  </button>
  {caption && <figcaption>{caption}</figcaption>}
  <div id={id} popover class="zoom">
    <button type="button" class="zoom-close" popovertarget={id} popovertargetaction="hide" aria-label="닫기">
      <img src={src} alt="" />
    </button>
  </div>
</figure>

<style>
  .figure {
    margin: var(--space-8) 0;
  }

  .zoom-trigger {
    display: block;
    width: 100%;
    border: var(--border-thin) solid var(--line-soft);
    cursor: zoom-in;
  }

  .zoom-trigger img {
    width: 100%;
    margin: 0;
  }

  figcaption {
    margin-top: var(--space-3);
    color: var(--fg-subtle);
    font-size: var(--text-xs);
    text-align: center;
  }

  .zoom {
    inset: 0;
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    padding: var(--space-6);
    border: 0;
    background: var(--bg-scrim);
    backdrop-filter: blur(6px);
    opacity: 0;
    transition:
      opacity var(--duration-base) var(--ease-standard),
      display var(--duration-base) allow-discrete,
      overlay var(--duration-base) allow-discrete;
  }

  .zoom:popover-open {
    display: grid;
    opacity: 1;
  }

  @starting-style {
    .zoom:popover-open {
      opacity: 0;
    }
  }

  .zoom-close {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    cursor: zoom-out;
  }

  .zoom-close img {
    max-width: 100%;
    max-height: 100%;
    margin: 0;
    object-fit: contain;
  }
</style>
