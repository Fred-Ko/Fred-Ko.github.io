---
interface Props {postId:string}
const {postId}=Astro.props;
---
<section class="comments" aria-labelledby="comments-title" data-comments data-post-id={postId}>
 <header class="comments-heading"><div><h2 id="comments-title">댓글</h2></div><div data-session hidden></div></header>
 <div class="composer guest-composer" data-guest-editor>
   <textarea aria-label="로그인 후 댓글 작성" placeholder="댓글을 입력하세요." rows="3" readonly></textarea>
   <div class="composer-toolbar"><a class="login-button" href={`/api/auth/github/start?return_to=${encodeURIComponent(Astro.url.pathname+'#comments-title')}`}><svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M12 .8a11.2 11.2 0 0 0-3.54 21.83c.56.1.76-.24.76-.54v-2.1c-3.12.68-3.78-1.33-3.78-1.33-.51-1.3-1.24-1.65-1.24-1.65-1.02-.7.08-.68.08-.68 1.12.08 1.71 1.15 1.71 1.15 1 .1.8 2.33 3.28 1.64.1-.72.39-1.21.71-1.49-2.49-.28-5.11-1.25-5.11-5.54 0-1.22.44-2.22 1.15-3-.12-.28-.5-1.42.11-2.96 0 0 .94-.3 3.08 1.15a10.7 10.7 0 0 1 5.6 0c2.13-1.45 3.07-1.15 3.07-1.15.61 1.54.23 2.68.11 2.96.72.78 1.15 1.78 1.15 3 0 4.3-2.63 5.25-5.13 5.53.4.35.76 1.03.76 2.08v3.09c0 .3.2.65.77.54A11.2 11.2 0 0 0 12 .8Z"/></svg>GitHub 로그인<span aria-hidden="true">↗</span></a></div>
 </div>
 <form class="composer" hidden data-comment-form><label class="sr-only" for="comment-content">댓글 내용</label><textarea id="comment-content" name="content" placeholder="댓글을 입력하세요." minlength="2" maxlength="5000" rows="4" required></textarea><div class="composer-toolbar"><p>굵게, 기울임, 코드, 링크, 인용, 목록을 지원합니다.</p><div class="actions"><button type="button" data-cancel hidden>취소</button><button class="submit-comment" type="submit">댓글 등록</button></div></div></form>
 <p class="comment-status" role="status" data-comment-status>댓글을 불러오는 중입니다.</p>
 <ol data-comment-list role="list"></ol><button class="load-more" type="button" data-more hidden>댓글 더 보기</button>
</section>
<script>
 type User={id:string;display_name:string;login:string;profile_url:string;role:string;avatar_url?:string};
 type Comment={id:string;parent_id:string|null;content_markdown:string;content_html:string;created_at:string;author:User};
 const root=document.querySelector<HTMLElement>('[data-comments]');
 if(root){
  const postId=root.dataset.postId!;
  const base=`/api/posts/${encodeURIComponent(postId)}`;
  const session=root.querySelector<HTMLElement>('[data-session]')!;
  const form=root.querySelector<HTMLFormElement>('form')!;
  const guest=root.querySelector<HTMLElement>('[data-guest-editor]')!;
  const content=form.querySelector<HTMLTextAreaElement>('textarea')!;
  const status=root.querySelector<HTMLElement>('[data-comment-status]')!;
  const list=root.querySelector<HTMLOListElement>('[data-comment-list]')!;
  const more=root.querySelector<HTMLButtonElement>('[data-more]')!;
  const cancel=root.querySelector<HTMLButtonElement>('[data-cancel]')!;
  let user:User|null=null,cursor:string|null=null,editing:string|null=null;
  const request=async(path:string,init?:RequestInit)=>{
   const response=await fetch(path,{credentials:'include',...init,headers:{'content-type':'application/json',...init?.headers},signal:AbortSignal.timeout(10000)});
   const data=await response.json();
   if(!response.ok)throw new Error(data.error??'요청을 처리하지 못했습니다.');
   return data;
  };
  const notice=(message:string)=>{status.textContent=message;};
  const reset=()=>{form.reset();editing=null;cancel.hidden=true;form.querySelector('button[type="submit"]')!.textContent='댓글 등록';};
  cancel.addEventListener('click',reset);
  const action=(label:string,callback:()=>void)=>{const button=document.createElement('button');button.type='button';button.textContent=label;button.addEventListener('click',callback);return button;};
  const append=(comment:Comment)=>{
   const li=document.createElement('li');li.id=`comment-${comment.id}`;
   const header=document.createElement('p');header.className='comment-meta';
   const author=document.createElement('a');author.textContent=comment.author.display_name||comment.author.login;author.href=comment.author.profile_url;author.target='_blank';author.rel='noopener';
   if(comment.author.avatar_url){const avatar=document.createElement('img');avatar.src=comment.author.avatar_url;avatar.alt='';avatar.width=40;avatar.height=40;avatar.loading='lazy';avatar.className='comment-avatar';header.append(avatar);}
   const time=document.createElement('time');time.dateTime=comment.created_at;const normalized=comment.created_at.includes('T')?comment.created_at:`${comment.created_at.replace(' ','T')}Z`;time.textContent=new Intl.DateTimeFormat('ko-KR',{dateStyle:'medium',timeStyle:'short'}).format(new Date(normalized));
   header.append(author,time);li.append(header);
   if(comment.parent_id){const reply=document.createElement('a');reply.href=`#comment-${comment.parent_id}`;reply.textContent='원댓글 보기 ↑';li.append(reply);}
   const body=document.createElement('div');body.className='comment-body prose';body.innerHTML=comment.content_html;li.append(body);
   if(user){
    const actions=document.createElement('div');actions.className='actions';
    if(user.id===comment.author.id||user.role==='admin'){
     actions.append(action('수정',()=>{reset();editing=comment.id;content.value=comment.content_markdown;cancel.hidden=false;form.querySelector('button[type="submit"]')!.textContent='수정 저장';content.focus();}));
     actions.append(action('삭제',async()=>{
      if(!window.confirm('이 댓글을 삭제할까요?'))return;
      try{await request(`/api/comments/${encodeURIComponent(comment.id)}`,{method:'DELETE'});await load();notice('댓글을 삭제했습니다.');document.dispatchEvent(new Event('post-comments-changed'));}catch(error){notice((error as Error).message);}
     }));
    }
    li.append(actions);
   }
   list.append(li);
  };
  let loadEpoch=0;
  const load=async(appendPage=false)=>{
   const epoch=++loadEpoch;
   const data=await request(`${base}/comments${appendPage&&cursor?`?before=${encodeURIComponent(cursor)}`:''}`);
   if(epoch!==loadEpoch)return;
   if(!appendPage)list.replaceChildren();
   data.comments.forEach(append);cursor=data.next_cursor;more.hidden=!cursor;
   notice(list.children.length?'':'첫 댓글을 남겨보세요.');
  };
  more.addEventListener('click',async()=>{more.disabled=true;try{await load(true);}catch(error){notice((error as Error).message);}finally{more.disabled=false;}});
  form.addEventListener('submit',async(event)=>{
   event.preventDefault();const button=form.querySelector<HTMLButtonElement>('button[type="submit"]')!;button.disabled=true;
   try{
    const result=await request(editing?`/api/comments/${encodeURIComponent(editing)}`:`${base}/comments`,{method:editing?'PATCH':'POST',body:JSON.stringify({content:content.value})});
    reset();await load();notice(result.status==='pending'?'댓글을 등록했습니다. 승인 후 표시됩니다.':'댓글을 저장했습니다.');document.dispatchEvent(new Event('post-comments-changed'));
   }catch(error){notice((error as Error).message);}finally{button.disabled=false;}
  });
  (async()=>{
   try{
    const data=await request('/api/auth/session');user=data.user;
    if(user){
     const label=document.createElement('a');label.textContent=user.display_name||user.login;label.href=user.profile_url;label.target='_blank';label.rel='noopener';
     session.hidden=false;guest.hidden=true;session.replaceChildren(label,action('로그아웃',async()=>{try{await request('/api/auth/logout',{method:'POST'});location.reload();}catch(error){notice((error as Error).message);}}));form.hidden=false;
    }
   }catch{ /* 댓글 조회는 로그인 서비스 장애와 별개로 시도한다. */ }
   try{await load();}catch{notice('댓글을 불러오지 못했습니다. 잠시 후 다시 방문해 주세요.');}
  })();
 }
</script>
<style>
.comments :global(.comment-avatar){width:40px;height:40px;border-radius:50%;object-fit:cover}.comments :global(.comment-meta time){margin-left:auto}
.comments{margin-block:var(--space-12);padding-top:var(--space-8);border-top:1px solid var(--line)}
.comments-heading{display:flex;align-items:center;justify-content:space-between;gap:var(--space-4);margin-bottom:var(--space-6)}
.eyebrow{font-size:var(--text-xs);color:var(--fg-subtle);margin-bottom:.35rem}h2{font-size:var(--text-2xl);letter-spacing:var(--tracking-heading)}
.composer{border:1px solid var(--line-control);background:var(--bg-raised)}
textarea{display:block;width:100%;resize:vertical;min-height:7rem;padding:var(--space-5);border:0;background:transparent;color:var(--fg-prose);font:inherit;font-size:var(--text-sm);line-height:1.7}
textarea::placeholder{color:var(--fg-subtle)}textarea[readonly]{resize:none;cursor:default}
textarea:focus-visible{outline-offset:-2px}
.composer-toolbar{display:flex;justify-content:space-between;align-items:center;gap:var(--space-4);padding:var(--space-3) var(--space-4);border-top:1px solid var(--line-soft)}
.composer-toolbar p{color:var(--fg-subtle);font-size:var(--text-xs);line-height:1.6}
.login-button,.submit-comment{display:inline-flex;align-items:center;justify-content:center;gap:.55rem;white-space:nowrap;min-height:44px;padding:.55rem .9rem;background:var(--accent);color:var(--accent-fg);font-size:var(--text-xs);font-weight:var(--weight-medium);text-decoration:none;border:1px solid var(--accent)}
.login-button:hover,.submit-comment:hover{background:var(--hover-bg);color:var(--hover-fg);border-color:var(--hover-border)}
.comment-status{font-size:var(--text-sm);line-height:1.7;color:var(--fg-subtle);margin-block:var(--space-5)}
[data-comment-list]{padding:0;list-style:none}.comments :global(li){padding-block:var(--space-6);border-bottom:1px solid var(--line-soft)}
.comments :global(.comment-meta){display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap;font-size:var(--text-xs);color:var(--fg-subtle);margin-bottom:var(--space-3)}
.comments :global(.comment-meta a){font-weight:var(--weight-medium);color:var(--fg-strong)}
.comments :global(.actions),.actions{display:flex;gap:.5rem;flex-wrap:wrap}
.comments :global(.actions button:not(.submit-comment)),.load-more,[data-session] :global(button){min-height:36px;padding:.4rem .65rem;border:1px solid var(--line-soft);color:var(--fg-subtle);font-size:var(--text-xs)}
.comments :global(.actions button:hover),.load-more:hover,[data-session] :global(button:hover){background:var(--hover-bg);color:var(--hover-fg);border-color:var(--hover-border)}
.comments :global(.comment-body){overflow-wrap:anywhere;font-size:var(--text-sm);margin-bottom:var(--space-4)}.comments :global(.comment-body p){white-space:pre-wrap}
[data-session]{display:flex;gap:.75rem;align-items:center;flex-wrap:wrap;font-size:var(--text-xs);color:var(--fg-muted)}[data-session][hidden]{display:none}
@media(width<600px){.comments{margin-top:var(--space-10)}textarea{padding:var(--space-4)}.composer-toolbar{align-items:flex-start;flex-direction:column;gap:.75rem}.composer-toolbar .login-button,.composer-toolbar .actions{align-self:flex-end}}
</style>
