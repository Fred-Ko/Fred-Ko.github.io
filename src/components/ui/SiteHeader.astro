---
/** SiteHeader — 상단 고정 바. 브랜드, 주요 탭, 검색(⌘K), 테마 선택. */
import ThemeToggle from './ThemeToggle.astro';
import {site} from '../../lib/site';

const nav = [
  { href: '/', label: 'Writing' },
  { href: '/categories/', label: 'Categories' },
  { href: '/tags/', label: 'Tags' },
  { href: '/archives/', label: 'Archives' },
  { href: '/about/', label: 'About' },
];
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header">
  <div class="container inner">
    <a class="brand" href="/" aria-label="Fredko Dev Log home">FREDKO<span>.</span><small>DEV LOG</small></a>
    <nav class="primary-nav" aria-label="주 메뉴">
      <ul role="list">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
        <li><a href={site.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a></li>
        <li><a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a></li>
      </ul>
    </nav>
    <ThemeToggle />
    <button type="button" class="search-trigger" data-search-open aria-label="Search">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path>
      </svg>
      <kbd class="label">⌘K</kbd>
    </button>
    <details class="mobile-menu"><summary aria-label="Menu"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg></summary><nav aria-label="모바일 메뉴"><div class="mobile-profile"><a href="/"><img src="/assets/img/avatar.jpg?v=green-bear-1" width="72" height="72" alt="Fredko Dev Log"/></a><a href="/">Fredko Dev Log</a></div><ul role="list">{nav.map(item=><li><a href={item.href}>{item.label}</a></li>)}<li><a href={site.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a></li><li><a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a></li></ul></nav></details>
  </div>
</header>

<style>
  .mobile-menu { display: none; }
  .mobile-profile {display:flex;align-items:center;gap:1rem;margin-bottom:1rem;}
  .mobile-profile img{width:72px;height:72px;border-radius:50%;}
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-topbar);
    border-bottom: var(--border-thin) solid var(--line);
    background: var(--bg-overlay);
    backdrop-filter: blur(12px);
    view-transition-name: site-header; /* 페이지 이동 중 헤더 고정 */
  }

  .inner {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    height: var(--topbar-height);
  }

  .brand {
    color: var(--fg-strong);
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: var(--weight-bold);
    letter-spacing: -0.05em;
    text-decoration: none;
  }

  .brand small {margin-left:.55rem;color:var(--fg-subtle);font-size:.8125rem;letter-spacing:.12em;}
  .brand span {
    color: var(--accent);
  }

  nav {
    margin-left: auto;
    overflow-x: auto;
    scrollbar-width: none;
  }

  ul {
    display: flex;
    align-items: center;
    gap: 2rem;
    padding: 0;
    list-style: none;
  }

  nav a {
    display: inline-block;
    padding-block: var(--space-2);
    color: var(--fg-subtle);
    text-decoration: none;
    white-space: nowrap;
    font-family: var(--font-display);
    font-size: .8rem;
    font-weight: 500;
    letter-spacing: normal;
    line-height: 1.65;
    text-transform: none;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--fg-strong);
  }

  nav a[aria-current='page'] {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 1px;
    text-underline-offset: .65rem;
  }

  .search-trigger {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    height: 2rem;
    padding: 0 var(--space-2);
    border: var(--border-thin) solid var(--line-control);
    color: var(--fg-subtle);
  }

  .search-trigger:hover {
    border-color: var(--hover-border);
    color: var(--fg-strong);
  }

  kbd {
    font-family: var(--font-display);
  }

  @media (width < 720px) {
    .inner {
      gap: var(--space-3);
    }

    ul {
      gap: var(--space-4);
    }

    kbd {
      display: none;
    }
  }

  @media (width < 600px) { .brand small {display:none;} }
  @media (width >= 1200px) {
    .primary-nav a {font-size:15px;}
    .primary-nav ul {gap:36px;}
  }
  @media (width < 992px) {
    .mobile-menu { display: block; }
    .mobile-menu summary { cursor:pointer; padding:.6rem; }
    .mobile-menu nav { display:block; position:absolute; top:100%; left:0; right:0; margin:0; padding:1rem; background:var(--bg); border-bottom:1px solid var(--line); }
    .mobile-menu ul { display:grid; gap:.5rem; }

    nav {
      display: none; /* 원본처럼 992px 미만에서는 메뉴 버튼으로 제공 */
    }

    .inner :global(.theme-toggle) {margin-left:auto;}
    .mobile-menu nav a {font-size:1rem;}
  }
</style>
