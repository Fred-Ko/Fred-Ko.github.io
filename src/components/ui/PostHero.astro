---
/**
 * PostHero — 포스트 상단. Kicker → 제목 → 설명 → 메타 → 태그 순서의 중앙 정렬 블록.
 */
import Tag from './Tag.astro';
import {taxonomySlug} from '../../lib/site';
import {site} from '../../lib/site';

interface Props {
  title: string;
  description?: string;
  category?: string;
  date: Date;
  updated?: Date;
  readingMinutes?: number;
  tags?: string[];
  /** WritingRow와 같은 값이면 목록 → 포스트 이동 시 제목이 이어진다 */
  transitionName?: string;
}
const { title, description, category, date, updated, readingMinutes, tags = [], transitionName } = Astro.props;
const fmt = (d: Date) =>
  d.toLocaleDateString('ko-KR', { year: 'numeric', month: '2-digit', day: '2-digit', timeZone: 'Asia/Seoul' });
const fmtUpdated=(d:Date)=>d.toLocaleDateString('en-US',{year:'numeric',month:'short',day:'numeric',timeZone:'Asia/Seoul'});
---

<header class="post-hero">
  <p class="post-kicker"><time datetime={date.toISOString()}>{fmt(date)}</time>{category && <span>{category}</span>}</p>
  <h1 data-pagefind-meta="title" style={transitionName ? `view-transition-name: ${transitionName}` : undefined}>{title}</h1>
  {description && <p class="desc">{description}</p>}
  <ul class="meta" aria-label="작성 정보" role="list">
    <li>Written by <a href={site.github}>{site.author}</a></li>
    {readingMinutes && <li>{readingMinutes} min read</li>}
    {updated && <li class="updated">Updated <time datetime={updated.toISOString()}>{fmtUpdated(updated)}</time></li>}
    <li class="mobile-info-item"><details class="mobile-info"><summary>Info</summary>
    {description && <p>{description}</p>}
    {updated && <p>Updated <time datetime={updated.toISOString()}>{fmtUpdated(updated)}</time></p>}
    {tags.length > 0 && <div class="mobile-tags">{tags.map(tag=><Tag href={`/tags/${taxonomySlug(tag)}/`} size="sm">{tag}</Tag>)}</div>}
  </details></li>
  </ul>
  {Astro.slots.has('meta') && <div class="engagement"><slot name="meta" /></div>}

  {
    tags.length > 0 && (
      <ul class="tags" role="list">
        {tags.slice(0,5).map((tag) => (
          <li>
            <Tag>{tag}</Tag>
          </li>
        ))}
      </ul>
    )
  }
</header>

<style>
  .post-kicker {display:flex;justify-content:center;align-items:center;flex-wrap:wrap;gap:var(--space-4);color:var(--accent);font-size:var(--text-2xs);font-family:var(--font-display);}
  .mobile-info,.mobile-info-item { display:none; }
  .mobile-tags {display:flex;flex-wrap:wrap;justify-content:center;gap:.4rem;margin-top:.5rem;}
  .post-hero {
    max-width: 72rem;
    margin-inline: auto;
    padding-block: clamp(2rem, 4vw, 3.5rem) 2.25rem;
    text-align: center;
  }

  h1 {
    margin: 1.7rem auto 0;
    font-size: clamp(2.4rem, 4.4vw, 3.35rem);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 1.16;
    text-wrap: balance;
  }

  .desc {
    max-width: 42rem;
    margin: var(--space-5) auto 0;
    color: var(--fg-muted);
    font-size: clamp(1rem, .95rem + .3vw, 1.125rem);
    line-height: 1.75;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-2) var(--space-3);
    margin-top: var(--space-4);
    padding: 0;
    list-style: none;
    color: var(--fg-subtle);
    font-size: var(--text-xs);
    line-height: 1.6;
    font-variant-numeric: tabular-nums;
  }

  .meta li { white-space: nowrap; }

  .meta li + li::before {
    margin-right: var(--space-3);
    color: var(--fg-subtle);
    content: '·';
  }

  .engagement {
    display: flex;
    justify-content: center;
    margin-top: var(--space-2);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
    margin-top: var(--space-4);
    padding: 0;
    list-style: none;
  }

  @media (width < 600px) {
    .post-hero { padding-block: var(--space-6) var(--space-6); }
    h1 { margin-top:1.25rem; font-size:clamp(2.45rem, 12vw, 4rem); text-wrap:initial; }
    .post-hero {text-align:left;}
    .post-kicker,.meta,.mobile-tags {justify-content:flex-start;}
    .desc { margin-top:var(--space-3); font-size:var(--text-base); line-height:1.6; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
    .meta { margin-top:var(--space-3); font-size:var(--text-2xs); }
    .meta .updated { display:none; }
    .engagement { margin-top:0; }
    .tags { display:none; }
    .mobile-info-item {display:flex;align-items:center;}
    .mobile-info-item:has([open]) {display:block;flex-basis:100%;white-space:normal;}
    .mobile-info-item:has([open])::before {display:none;}
    .mobile-info {display:block;margin-top:0;color:var(--fg-subtle);font-size:var(--text-xs);}
    .mobile-info summary {cursor:pointer;min-height:2rem;line-height:2rem;}
    .mobile-info p {margin-top:.5rem;}
    .tags { gap: .4rem; }
  }
</style>
