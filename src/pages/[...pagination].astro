---
import Home from '../components/blog/Home.astro';
import {getPosts} from '../lib/posts';
import {site} from '../lib/site';
export async function getStaticPaths(){const posts=await getPosts();return Array.from({length:Math.max(0,Math.ceil(posts.length/site.pageSize)-1)},(_,i)=>({params:{pagination:`page${i+2}`},props:{page:i+2}}));}
---
<Home page={Astro.props.page}/>
