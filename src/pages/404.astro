---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="404: Page not found" noindex><section class="container-prose missing"><h1>404: Page not found</h1><p>Sorry, we've misplaced that URL or it's pointing to something that doesn't exist.</p></section></BaseLayout>
<style>.missing{padding-block:var(--space-24)}h1{font-size:var(--text-3xl);margin-block:var(--space-6)}p{color:var(--fg-muted);margin-bottom:var(--space-6)}</style>
